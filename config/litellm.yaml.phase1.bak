# =============================================================================
# litellm.yaml — ai-hub: ponte Anthropic (/v1/messages do free-claude-code)
# → free LLM APIs. Porta 4001 (a do stack local ~/Documents/LLM é 4000 — não
# colidem).
#
# Rota "free-agent": NVIDIA NIM deepseek-v4-flash (PRIMÁRIO — o mesmo modelo
# do dia a dia do usuário, grátis) com fallback automático para Gemini 3.5
# Flash e Mistral Medium quando o primário falha/estoura quota.
#
# Iniciado por: bin/up   (exporta LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=true
#                        e as chaves NIM/GEMINI/MISTRAL_API_KEY do env/.env.free)
# Chaves: NIM_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY  (env/.env.free)
#
# Todos os backends usam prefixo "openai/" (são OpenAI-compatíveis) — o mesmo
# caminho já validado no stack local (flag + patch). Sem Responses API.
# =============================================================================

model_list:
  # ── PRIMÁRIO: NVIDIA NIM — deepseek-v4-flash-0731 (free, ocidental) ────────
  # Modelo: deepseek-ai/deepseek-v4-flash-0731 no corpo do request. O id SEM
  # sufixo (deepseek-v4-flash) expirou em 2026-08-07. Confirme os ids atuais com:
  # curl -s https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $NIM_API_KEY"
  - model_name: free-agent
    litellm_params:
      model: openai/deepseek-ai/deepseek-v4-flash-0731
      api_base: https://integrate.api.nvidia.com/v1
      api_key: os.environ/NIM_API_KEY
    fallbacks: ["free-agent-gemini", "free-agent-mistral"]

  # ── FALLBACK 1: Gemini 3.5 Flash (provavelmente acima da barra; 1500 RPD) ──
  - model_name: free-agent-gemini
    litellm_params:
      model: openai/gemini-3.5-flash
      api_base: https://generativelanguage.googleapis.com/v1beta/openai
      api_key: os.environ/GEMINI_API_KEY
    fallbacks: ["free-agent-mistral"]

  # ── FALLBACK 2: Mistral Medium 3.5 (~1B tokens/mês, 128K ctx) ─────────────
  - model_name: free-agent-mistral
    litellm_params:
      model: openai/mistral-medium-latest
      api_base: https://api.mistral.ai/v1
      api_key: os.environ/MISTRAL_API_KEY

  # ── Modelo "pequeno" (títulos de conversa, resumos do fcc) ────────────────
  # Mesmo backend primário — títulos são curtos, custo irrelevante.
  - model_name: free-agent-small
    litellm_params:
      model: openai/deepseek-ai/deepseek-v4-flash-0731
      api_base: https://integrate.api.nvidia.com/v1
      api_key: os.environ/NIM_API_KEY

litellm_settings:
  drop_params: true        # ignora params que o backend free não suporta
  num_retries: 0           # sem retry automático (evita tool calls duplicadas)
  request_timeout: 300     # segundos — contexto grande + fallback podem demorar

router_settings:
  # Circuit-breaker por deployment: cooldown curto + só cooldown após N falhas
  cooldown_time: 5
  allowed_fails: 3
