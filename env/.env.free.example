# =============================================================================
# .env.free.example — chaves de API gratuitas do ai-hub.
# Copie para .env.free e preencha:
#   cp env/.env.free.example env/.env.free
#
# Todas são free tiers OFICIAIS (sem cartão de crédito). Onde gerar:
#   NIM_API_KEY       → https://build.nvidia.com  (conta NVIDIA Developer → API key)
#   GEMINI_API_KEY    → https://aistudio.google.com/apikey  (free tier)
#   MISTRAL_API_KEY   → https://console.mistral.ai  (plano Experiment, grátis)
#   GROQ_API_KEY      → https://console.groq.com/keys
#   CEREBRAS_API_KEY  → https://cloud.cerebras.ai/platform/account/api-keys
#   OPENROUTER_API_KEY→ https://openrouter.ai/keys
#   DEEPINFRA_API_KEY → https://deepinfra.com/dash/api_keys
#   SAMBANOVA_API_KEY → https://cloud.sambanova.ai/account/keys
#   DAHL_API_KEY      → https://inference.dahl.global  (token via fingerprint)
#   HF_API_KEY        → https://huggingface.co/settings/tokens  (Access Token)
#   UNCLOSEAI_API_KEY → https://uncloseai.com  (sem cadastro)
#
# Pelo menos NIM_API_KEY é necessária pro primário responder. APIs pagas e
# self-hosted também entram no hub (veja README → "APIs pagas e self-hosted").
# =============================================================================

NIM_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
SAMBANOVA_API_KEY=
DAHL_API_KEY=
# HF_API_KEY=
# UNCLOSEAI_API_KEY=
