# =============================================================================
# fcc-aihub.env — instância do free-claude-code do ai-hub (porta 8084).
# Backend: provider "llamacpp" (transporte Anthropic nativo, base URL custom)
# apontando pro LiteLLM local do ai-hub (porta 4001), que traduz
# Anthropic → OpenAI-compatível → free API (NIM/Gemini/Mistral).
#
# NÃO interfere nas outras instâncias do fcc (DeepSeek porta 8082, local 8083).
# =============================================================================

# ── Model routing (todos os tiers → rota free-agent) ─────────────────────────
MODEL=llamacpp/free-agent
MODEL_OPUS=llamacpp/free-agent
MODEL_SONNET=llamacpp/free-agent
MODEL_HAIKU=llamacpp/free-agent-small

# Backend: LiteLLM do ai-hub (porta 4001 — a do stack local é 4000)
LLAMACPP_BASE_URL=http://127.0.0.1:4001/v1

# ── Server próprio ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8084
ANTHROPIC_AUTH_TOKEN=freecc-aihub

# ── Sem bot de mensagem (config herdada usa discord) ─────────────────────────
MESSAGING_PLATFORM=none

# ── Thinking ─────────────────────────────────────────────────────────────────
# false por padrão: pipeline mais simples e rápido nos backends free
# (chat/completions sem raciocínio estendido). Se quiser testar o raciocínio
# estendido dos modelos, troque para true e confirme o patch do litellm
# (bin/up aplica; ver scripts/patch-litellm-thinking.py).
ENABLE_MODEL_THINKING=false

# ── Timeouts HTTP (clientes free podem demorar em contexto grande) ───────────
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=60
HTTP_CONNECT_TIMEOUT=60
